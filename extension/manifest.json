{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "1.1.0",
  "description": "__MSG_extDescription__",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://animestore.docomo.ne.jp/*",
    "https://jimaku.cc/*",
    "https://*.jimaku.cc/*",
    "https://graphql.anilist.co/*",
    "https://www.amazon.co.jp/gp/video/*",
    "https://www.amazon.co.jp/Prime-Video/*",
    "https://www.primevideo.com/*",
    "https://primevideo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://animestore.docomo.ne.jp/*",
        "https://www.amazon.co.jp/gp/video/*",
        "https://www.amazon.co.jp/Prime-Video/*",
        "https://www.primevideo.com/*",
        "https://primevideo.com/*"
      ],
      "js": [
        "i18n.js",
        "parser.js",
        "source_profiles.js",
        "players/registry.js",
        "players/danime.js",
        "players/prime.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
