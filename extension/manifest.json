{
  "manifest_version": 3,
  "name": "字幕アシスタント (dアニメ・Prime Video)",
  "version": "1.1.0",
  "description": "dアニメストア・Prime Videoに日本語字幕を追加。Jimakuのアニメ・ドラマ検索、字幕ファイル読込、クリックでタイミング調整。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://animestore.docomo.ne.jp/*",
    "https://jimaku.cc/*",
    "https://*.jimaku.cc/*",
    "https://graphql.anilist.co/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://www.amazon.co.jp/gp/video/*",
    "https://www.amazon.co.jp/Prime-Video/*",
    "https://www.primevideo.com/*",
    "https://primevideo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://animestore.docomo.ne.jp/*",
        "https://www.amazon.co.jp/gp/video/*",
        "https://www.amazon.co.jp/Prime-Video/*",
        "https://www.primevideo.com/*",
        "https://primevideo.com/*"
      ],
      "js": [
        "parser.js",
        "player.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
